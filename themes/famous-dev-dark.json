    "editorActiveLineNumber.foreground": "#cdd6f4",
    "editorLink.activeForeground": "#89b4fa",
    "editorSuggestWidget.background": "#181825",
    "editorSuggestWidget.border": "#313244",
    "editorSuggestWidget.foreground": "#cdd6f4",
    "editorSuggestWidget.highlightForeground": "#f5e0dc",
    "editorSuggestWidget.selectedBackground": "#313244",
    "editorHoverWidget.background": "#181825",
    "editorHoverWidget.border": "#313244",
    "editorMarkerNavigation.background": "#181825",
    "editorMarkerNavigationError.background": "#f38ba8",
    "editorMarkerNavigationWarning.background": "#f9e2af",
    "editorMarkerNavigationInfo.background": "#89dceb",
    "editorGhostText.foreground": "#6c7086",
    
    // Activity Bar
    "activityBar.background": "#11111b",
    "activityBar.foreground": "#cdd6f4",
    "activityBar.inactiveForeground": "#6c7086",
    "activityBar.border": "#11111b",
    "activityBarBadge.background": "#cba6f7",
    "activityBarBadge.foreground": "#11111b",
    
    // Side Bar
    "sideBar.background": "#11111b",
    "sideBar.foreground": "#cdd6f4",
    "sideBar.border": "#11111b",
    "sideBarTitle.foreground": "#cdd6f4",
    "sideBarSectionHeader.background": "#181825",
    "sideBarSectionHeader.foreground": "#cdd6f4",
    "sideBarSectionHeader.border": "#11111b",
    
    // Panel
    "panel.background": "#181825",
    "panel.border": "#313244",
    "panelTitle.activeBorder": "#cba6f7",
    "panelTitle.activeForeground": "#cba6f7",
    "panelTitle.inactiveForeground": "#6c7086",
    
    // Status Bar
    "statusBar.background": "#11111b",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.border": "#11111b",
    "statusBar.debuggingBackground": "#fab387",
    "statusBar.debuggingForeground": "#11111b",
    "statusBar.noFolderBackground": "#11111b",
    "statusBar.noFolderForeground": "#cdd6f4",
    "statusBarItem.hoverBackground": "#313244",
    "statusBarItem.remoteBackground": "#cba6f7",
    "statusBarItem.remoteForeground": "#11111b",
    
    // Title Bar
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#181825",
    "titleBar.inactiveForeground": "#6c7086",
    "titleBar.border": "#11111b",
    
    // Tabs
    "tab.activeBackground": "#181825",
    "tab.activeForeground": "#cba6f7",
    "tab.border": "#11111b",
    "tab.inactiveBackground": "#11111b",
    "tab.inactiveForeground": "#6c7086",
    "tab.unfocusedActiveBackground": "#11111b",
    "tab.unfocusedInactiveBackground": "#11111b",
    
    // Terminal
    "terminal.background": "#181825",
    "terminal.foreground": "#cdd6f4",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#f5c2e7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#a6adc8",
    
    // Dropdown
    "dropdown.background": "#181825",
    "dropdown.foreground": "#cdd6f4",
    "dropdown.border": "#313244",
    
    // Input
    "input.background": "#181825",
    "input.foreground": "#cdd6f4",
    "input.border": "#313244",
    "input.placeholderForeground": "#6c7086",
    "inputOption.activeBackground": "#313244",
    "inputOption.activeBorder": "#cba6f7",
    
    // Button
    "button.background": "#cba6f7",
    "button.foreground": "#11111b",
    "button.hoverBackground": "#f5e0dc",
    
    // List
    "list.activeSelectionBackground": "#313244",
    "list.activeSelectionForeground": "#cba6f7",
    "list.dropBackground": "#313244",
    "list.focusBackground": "#313244",
    "list.focusForeground": "#cdd6f4",
    "list.highlightForeground": "#f5e0dc",
    "list.hoverBackground": "#313244",
    "list.hoverForeground": "#cdd6f4",
    "list.inactiveSelectionBackground": "#181825",
    "list.inactiveSelectionForeground": "#cba6f7",
    "list.invalidItemForeground": "#f38ba8",
    
    // Git Colors
    "gitDecoration.addedResourceForeground": "#a6e3a1",
    "gitDecoration.modifiedResourceForeground": "#f9e2af",
    "gitDecoration.deletedResourceForeground": "#f38ba8",
    "gitDecoration.untrackedResourceForeground": "#a6e3a1",
    "gitDecoration.ignoredResourceForeground": "#6c7086",
    "gitDecoration.conflictingResourceForeground": "#f5c2e7",
    "gitDecoration.submoduleResourceForeground": "#89dceb",
    
    // Notifications
    "notification.background": "#181825",
    "notification.foreground": "#cdd6f4",
    "notification.buttonBackground": "#cba6f7",
    "notification.buttonForeground": "#11111b",
    "notification.buttonHoverBackground": "#f5e0dc",
    "notification.errorBackground": "#f38ba8",
    "notification.errorForeground": "#11111b",
    "notification.infoBackground": "#89dceb",
    "notification.infoForeground": "#11111b",
    "notification.warningBackground": "#f9e2af",
    "notification.warningForeground": "#11111b",
    
    // Minimap
    "minimap.background": "#11111b",
    "minimap.findMatchHighlight": "#a6adc8",
    "minimap.selectionHighlight": "#6c7086",
    "minimap.errorHighlight": "#f38ba8",
    "minimap.warningHighlight": "#f9e2af",
    "minimapSlider.background": "#585b70",
    "minimapSlider.hoverBackground": "#6c7086",
    "minimapSlider.activeBackground": "#cba6f7",
    
    // Scrollbar
    "scrollbar.shadow": "#11111b",
    "scrollbarSlider.background": "#585b70",
    "scrollbarSlider.hoverBackground": "#6c7086",
    "scrollbarSlider.activeBackground": "#cba6f7",
    
    // Peek View
    "peekView.border": "#313244",
    "peekViewEditor.background": "#11111b",
    "peekViewEditorGutter.background": "#11111b",
    "peekViewResult.background": "#11111b",
    "peekViewResult.fileForeground": "#cdd6f4",
    "peekViewResult.lineForeground": "#6c7086",
    "peekViewResult.matchHighlightBackground": "#6c7086",
    "peekViewResult.selectionBackground": "#313244",
    "peekViewResult.selectionForeground": "#cdd6f4",
    "peekViewTitle.background": "#11111b",
    "peekViewTitleDescription.foreground": "#6c7086",
    "peekViewTitleLabel.foreground": "#cdd6f4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.object.property",
        "variable.other.constant.property",
        "variable.other.constant",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#eba0ac"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "variable.other.constant.property"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default",
        "meta.import",
        "meta.export"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "JSX/TSX",
      "scope": [
        "meta.jsx",
        "meta.jsx.children",
        "meta.jsx.attribute",
        "variable.other.readwrite.js",
        "variable.other.property.js",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class",
        "meta.attribute.class.html"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "CSS IDs",
      "scope": [
        "entity.other.attribute-name.id",
        "entity.name.fragment"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.deprecated",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "message.error",
        "token.error-token"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Warnings",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Infos",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "HTML Tags",
      "scope": [
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cba6f7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Markdown Lists",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Functions",
      "scope": [
        "meta.function-call.python",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Python Variables",
      "scope": [
        "variable.other.python",
        "meta.function-call.arguments.python"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Python Parameters",
      "scope": [
        "variable.parameter.function.python"
      ],
      "settings": {
        "foreground": "#eba0ac"
      }
    },
    {
      "name": "PHP Variables",
      "scope": [
        "variable.other.php",
        "variable.other.property.php",
        "variable.other.global.php"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "C++ Types",
      "scope": [
        "storage.type.cpp",
        "storage.type.c",
        "storage.modifier.cpp",
        "storage.modifier.c"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Java Types",
      "scope": [
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.java",
        "storage.type.annotation.java",
        "storage.type.generic.java"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml",
        "string.unquoted.plain.out.yaml",
        "string.unquoted.yaml"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "YAML Values",
      "scope": [
        "string.unquoted.plain.out.yaml",
        "string.unquoted.block.yaml",
        "string.quoted.double.yaml"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "ENV Variables",
      "scope": [
        "variable.other.env"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Bash Variables",
      "scope": [
        "variable.other.readwrite.bash",
        "variable.other.assignment.bash"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Bash Keywords",
      "scope": [
        "keyword.operator.word.bash",
        "keyword.control.bash"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Tailwind CSS",
      "scope": [
        "string.unquoted.plain.out.css",
        "meta.property-value.css",
        "variable.other.constant.property.css"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    }
  ]
}