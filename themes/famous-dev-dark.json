    "editorOverviewRuler.bracketMatchForeground": "#cba6f7",
    "editorOverviewRuler.findMatchForeground": "#f5e0dc",
    "editorOverviewRuler.rangeHighlightForeground": "#f5e0dc",
    "editorOverviewRuler.selectionHighlightForeground": "#cba6f7",
    "editorOverviewRuler.wordHighlightForeground": "#cba6f7",
    "editorOverviewRuler.wordHighlightStrongForeground": "#f2cdcd",
