    "activityBarBadge.background": "#b48ead",
    "activityBarBadge.foreground": "#0a0a10",
    
    // Side Bar
    "sideBar.background": "#0a0a10",
    "sideBar.foreground": "#c0c5ce",
    "sideBar.border": "#0a0a10",
