  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4f5b66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#b48ead",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.object.property",
        "variable.other.constant.property",
        "variable.other.constant",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#c0c5ce"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8fa1b3"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "entity.other.inherited-class",
        "variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "Types",
      "scope": [
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#96b5b4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "variable.other.constant.property"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default",
        "meta.import",
        "meta.export"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "name": "JSX/TSX Elements",
      "scope": [
        "meta.jsx",
        "meta.jsx.children",
        "meta.jsx.attribute",
        "variable.other.readwrite.js",
        "variable.other.property.js",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#c0c5ce"
      }
    },
    {
      "name": "JSX/TSX Tags",
      "scope": [
        "meta.jsx entity.name.tag",
        "meta.jsx entity.name.tag punctuation.definition.tag",
        "meta.jsx entity.name.tag punctuation.definition.tag.begin",
        "meta.jsx entity.name.tag punctuation.definition.tag.end",
        "punctuation.definition.tag.jsx",
        "meta.tag.jsx",
        "meta.tag.without.attributes.jsx",
        "meta.tag.js",
        "meta.tag.without.attributes.js"
      ],
      "settings": {
        "foreground": "#bf616a"
      }
    },
    {
      "name": "JSX/TSX Component Names",
      "scope": [
        "support.class.component",
        "entity.name.type.class.jsx",
        "support.class.component.jsx",
        "entity.name.function.react"
      ],
      "settings": {
        "foreground": "#ebcb8b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSX/TSX Attributes",
      "scope": [
        "meta.jsx entity.other.attribute-name",
        "meta.jsx string",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "React Hooks",
      "scope": [
        "variable.other.readwrite.js",
        "variable.other.constant.js",
        "meta.function-call.js variable.function.js"
      ],
      "settings": {
        "foreground": "#8fa1b3"
      }
    },
    {
      "name": "JavaScript Classes",
      "scope": [
        "meta.class.js",
        "entity.name.type.class.js",
        "variable.other.readwrite.alias.js",
        "support.class.builtin.js"
      ],
      "settings": {
        "foreground": "#ebcb8b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JavaScript Methods",
      "scope": [
        "meta.method.js",
        "entity.name.function.method.js",
        "variable.other.property.js"
      ],
      "settings": {
        "foreground": "#8fa1b3"
      }
    },
    {
      "name": "JavaScript Imports/Exports",
      "scope": [
        "meta.import.js",
        "meta.export.js",
        "keyword.control.import.js",
        "keyword.control.export.js",
        "meta.import variable.other.readwrite.js",
        "meta.export variable.other.readwrite.js"
      ],
      "settings": {
        "foreground": "#b48ead"
      }
    },
    {
      "name": "JavaScript Promises and Async",
      "scope": [
        "support.type.object.promise.js",
        "keyword.operator.expression.await.js",
        "storage.type.js"
      ],
      "settings": {
        "foreground": "#d08770",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JavaScript Properties",
      "scope": [
        "variable.other.property.js",
        "meta.property.object.js"
      ],
      "settings": {
        "foreground": "#c0c5ce"
      }
    },
    {
      "name": "JavaScript Function Parameters",
      "scope": [
        "variable.parameter.function.js",
        "meta.function.parameters.js"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "JavaScript Destructuring",
      "scope": [
        "meta.object-binding-pattern.js",
        "meta.array-binding-pattern.js",
        "variable.other.readwrite.js variable.other.readwrite.js"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "React Specific Hooks",
      "scope": [
        "variable.function.useState",
        "variable.function.useEffect",
        "variable.function.useContext",
        "variable.function.useReducer",
        "variable.function.useCallback",
        "variable.function.useMemo",
        "variable.function.useRef",
        "variable.function.useLayoutEffect",
        "variable.function.useImperativeHandle",
        "variable.function.useDebugValue",
        "variable.function.useTransition",
        "variable.function.useDeferredValue"
      ],
      "settings": {
        "foreground": "#b48ead",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Next.js Components",
      "scope": [
        "variable.other.readwrite.js",
        "support.class.component.next",
        "variable.other.constant.property",
        "support.type.next",
        "variable.other.property.js"
      ],
      "settings": {
        "foreground": "#96b5b4"
      }
    },
    {
      "name": "Next.js Imports",
      "scope": [
        "variable.other.readwrite.next",
        "support.module.next",
        "support.variable.next"
      ],
      "settings": {
        "foreground": "#d08770"
      }
    },
    {
      "name": "Vue Template Tags",
      "scope": [
        "meta.tag.template.vue",
        "entity.name.tag.template.html",
        "punctuation.definition.tag.begin.html.vue",
