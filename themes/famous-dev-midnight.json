    "sideBarSectionHeader.background": "#0a0a10",
    "sideBarSectionHeader.foreground": "#c0c5ce",
    "sideBarSectionHeader.border": "#0a0a10",
    
    // Panel
    "panel.background": "#0a0a10",
    "panel.border": "#1b1b2b",
    "panelTitle.activeBorder": "#b48ead",
    "panelTitle.activeForeground": "#b48ead",
