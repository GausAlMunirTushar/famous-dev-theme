    "editor.lineHighlightBorder": "#f2f4f8",
    "editorLineNumber.foreground": "#a0a0a0",
    "editorCursor.foreground": "#2d323c",
    "editor.selectionBackground": "#d0e6ff",
    "editor.selectionHighlightBackground": "#e6f4ff",
    "editor.wordHighlightBackground": "#e6f4ff",
    "editor.wordHighlightStrongBackground": "#e6f4ff",
    "editor.findMatchBackground": "#ffeaa7",
    "editor.findMatchHighlightBackground": "#f1c40f",
    "editor.hoverHighlightBackground": "#f5f7fa",
    "editor.lineNumbers": "#a0a0a0",
    "editor.rangeHighlightBackground": "#f2f4f8",
    "editor.inactiveSelectionBackground": "#e6f4ff",
    "editorBracketMatch.background": "#d0e6ff",
    "editorBracketMatch.border": "#a0a0a0",
    "editorCodeLens.foreground": "#a0a0a0",
    "editorError.foreground": "#e74c3c",
